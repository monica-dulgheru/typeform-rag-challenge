# =============================================================================
# TYPEFORM RAG ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your values
# This file contains ONLY infrastructure and credentials configuration
# Model/experiment parameters are configured in dev_interactive_run.py

# Project Configuration
# For Docker - NO TRAILING or LEADING SPACES: /app
# For local: /full/path/to/your/project
PROJECT_ROOT=/app

# Google Cloud Configuration
GOOGLE_CREDENTIALS_FILE=your-google-cloud-credentials-file-name.json
GCP_PROJECT_ID=your-gcp-project-id

# Pinecone Configuration: place the key by itself, nothing else, in a file and save it in credentials/
PINECONE_API_KEY_FILE=your-pinecone-api-key-file-name.whateverExtention_or_NoExtention

# Application Configuration - docker only
PYTHONUNBUFFERED=1
PYTHONPATH=/app



